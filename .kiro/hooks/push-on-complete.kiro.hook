{
  "enabled": true,
  "name": "Push to GitHub on task complete",
  "description": "After the agent finishes a task, commit any changes and push to GitHub so Netlify auto-deploys the latest version.",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "askAgent",
    "prompt": "If there are any uncommitted changes in the workspace: 1) First increment the patch version in package.json (e.g. 1.1.2 becomes 1.1.3), 2) Stage all changes with git add -A, 3) Read the NEW version from package.json, 4) Commit with the version prefix (e.g. 'v1.1.3: description of changes'), 5) Push to origin. If there are no uncommitted changes, do nothing."
  }
}